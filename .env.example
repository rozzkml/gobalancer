# ============================================================
# LLM GATEWAY - Environment Variables
#
# Di Vercel: Settings → Environment Variables → tambah satu per satu
# Di lokal  : copy ke .env lalu isi
# ============================================================

# ── GOOGLE GEMINI (Gratis) ── https://aistudio.google.com ──
# Auto-detect GEMINI_API_KEY, atau GEMINI_API_KEY_1 .. _50 (buat rotasi kuota)
GEMINI_API_KEY_1=AIzaSyxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY_2=AIzaSyyyyyyyyyyyyyyyyyyyyy
# dst... sampai GEMINI_API_KEY_50

# ── GATEWAY AUTH (rekomendasi) ─────────────────────────────
# Kunci akses gateway. Client wajib kirim: Authorization: Bearer <key>
# Comma-separated buat multi-key. Kalau kosong → gateway OPEN.
GATEWAY_KEYS=sk-ganti-ini,sk-key-kedua
