# ============================================================
# LLM GATEWAY v2 - Environment Variables
# 
# Di Vercel: Settings → Environment Variables → tambah satu per satu
# Di lokal  : copy ke .env lalu isi
#
# Tambah sebanyak yang kamu mau, auto-detect sampai _50
# ============================================================

# ── GROQ (Gratis) ── https://console.groq.com ──────────────
GROQ_API_KEY_1=gsk_xxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY_2=gsk_yyyyyyyyyyyyyyyyyyyyyy
GROQ_API_KEY_3=gsk_zzzzzzzzzzzzzzzzzzzzzz
# dst... sampai GROQ_API_KEY_50

# ── GOOGLE GEMINI (Gratis) ── https://aistudio.google.com ──
GEMINI_API_KEY_1=AIzaSyxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY_2=AIzaSyyyyyyyyyyyyyyyyyyyyy
GEMINI_API_KEY_3=AIzaSyzzzzzzzzzzzzzzzzzzz
# dst... sampai GEMINI_API_KEY_50

# ── DEEPSEEK (Murah ~$0.14/1M) ── https://platform.deepseek.com ──
DEEPSEEK_API_KEY_1=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY_2=sk-yyyyyyyyyyyyyyyyyyyyyyyy
# dst... sampai DEEPSEEK_API_KEY_50

# ── OLLAMA (Lokal, opsional) ──────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
